APP_NAME="Advokatska kancelarija"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Site default language (frontend chrome + admin). Blog content is single-language.
APP_LOCALE=sr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Default: SQLite — one file at database/database.sqlite, no server/credentials.
DB_CONNECTION=sqlite
# To use MySQL instead, comment the line above and uncomment these:
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=site
# DB_USERNAME=root
# DB_PASSWORD=

# Admin panel URL segment — use a random slug per deployment (e.g. admin-x7k2p9).
ADMIN_PATH=admin

# Seeded admin account (change the password immediately after first login).
SEED_ADMIN_NAME="Site Admin"
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me

# --- Client profile (see config/site.php). `php artisan site:new` writes these. ---
SITE_NAME="My Site"
SITE_TAGLINE=""
# Business preset: generic | media | law | artist | shop
SITE_PRESET=generic
# Brand defaults (also editable in Admin → Site settings, which wins).
SITE_BRAND_PRIMARY="#1a3d5c"
SITE_BRAND_ACCENT="#c9a24a"
SITE_BRAND_FONT="Inter"
# Allowed CORS origins for client frontends (comma-separated; * in local dev).
CORS_ALLOWED_ORIGINS=*

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
